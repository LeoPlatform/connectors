{
	"name": "leo-connector-datalake",
	"version": "0.1.0",
	"description": "A Databricks Delta Lake connector for use with Leo Platform",
	"repository": {
		"type": "git",
		"url": "git://github.com/LeoPlatform/connectors.git"
	},
	"main": "index.js",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"lint": "eslint index.js lib/**/*.js test/**/*.js",
		"test": "mocha test/unit/**/*.test.js",
		"test:int": "AWS_REGION=us-east-1 mocha test/integration/**/*.test.js --timeout 120000",
		"test:int-local": "LEO_LOCAL=true AWS_REGION=us-east-1 mocha test/integration/**/*.test.js --timeout 120000",
		"format": "echo 'no formatter configured'"
	},
	"author": "",
	"license": "ISC",
	"bugs": {
		"url": "https://github.com/LeoPlatform/connectors/issues"
	},
	"homepage": "https://github.com/LeoPlatform/connectors#readme",
	"dependencies": {
		"@databricks/sql": "^1.15.0",
		"async": "2.6.3",
		"generic-pool": "^3.9.0",
		"farmhash-modern": "^1.1.0",
		"fast-csv": "2.4.1",
		"leo-connector-common": "5.0.3",
		"leo-logger": "1.0.1",
		"leo-sdk": "7.1.12",
		"leo-streams": "2.0.0",
		"lodash": "^4.17.21"
	},
	"devDependencies": {
		"@aws-sdk/client-cloudformation": "^3.427.0",
		"@aws-sdk/client-dynamodb": "^3.427.0",
		"@aws-sdk/client-firehose": "^3.427.0",
		"@aws-sdk/client-kinesis": "^3.427.0",
		"@aws-sdk/client-lambda": "^3.427.0",
		"@aws-sdk/client-s3": "^3.427.0",
		"@aws-sdk/client-secrets-manager": "^3.427.0",
		"@aws-sdk/client-sts": "^3.427.0",
		"@aws-sdk/credential-providers": "^3.427.0",
		"@aws-sdk/lib-dynamodb": "^3.515.0",
		"@aws-sdk/lib-storage": "^3.427.0",
		"chai": "^4.2.0",
		"eslint": "^5.13.0",
		"mocha": "^5.2.0",
		"proxyquire": "^2.1.3",
		"sinon": "^7.2.3"
	}
}
